{
  "name": "etiquetas-colineal",
  "version": "1.0.0",
  "private": true,
  "description": "Etiquetas Colineal — Front React (:3000) + API (:3010) + print-agent",
  "scripts": {
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "dev": "concurrently -k -n api,web -c green,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start:api": "cross-env NODE_ENV=production tsx server/index.ts",
    "start:web": "cross-env NODE_ENV=production tsx server/web.ts",
    "start": "cross-env NODE_ENV=production concurrently -k -n api,web -c green,cyan \"tsx server/index.ts\" \"tsx server/web.ts\"",
    "preview": "npm run build && npm run start",
    "network:info": "powershell -ExecutionPolicy Bypass -File scripts/network-info.ps1",
    "network:firewall": "powershell -ExecutionPolicy Bypass -File scripts/allow-port-3000.ps1",
    "network:firewall:api": "powershell -ExecutionPolicy Bypass -File scripts/allow-port-3010.ps1",
    "publish:print-agent": "powershell -ExecutionPolicy Bypass -File scripts/publish-print-agent.ps1",
    "build:print-agent-exe": "powershell -ExecutionPolicy Bypass -File print-agent/installer/build-exe.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "keywords": [
    "etiquetas",
    "zebra",
    "odoo",
    "colineal"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@prisma/client": "^6.10.1",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-scroll-area": "^1.2.15",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-slot": "^1.3.0",
    "bwip-js": "^4.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "handlebars": "^4.7.8",
    "http-proxy-middleware": "^3.0.7",
    "lucide-react": "^1.25.0",
    "pg": "^8.22.0",
    "puppeteer": "^24.10.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.21",
    "prisma": "^6.10.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
