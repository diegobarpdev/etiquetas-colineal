# --- Etiquetas Colineal: Front :3000 + API :3010 ---
WEB_PORT=3000
API_PORT=3010
HOST=0.0.0.0
PUBLIC_URL=http://192.168.2.28:3000
# API_URL=http://127.0.0.1:3010

# Órdenes desde PostgreSQL Odoo (solo lectura)
ODOO_DATABASE_URL="postgresql://USUARIO:CLAVE@172.16.20.116:5432/ctin_produccion?schema=public"
ODOO_READ_ONLY=true

# BD local (inspectores personalizados, etc.)
DATABASE_URL="postgresql://colineal:colineal@localhost:5433/etiquetas?schema=public"

# Config impresoras (JSON en data/)
# PRINTERS_CONFIG_DIR=./data

# Ruta al chrome.exe de Puppeteer. Necesario si el servicio corre como SYSTEM
# (el cache de puppeteer queda en el perfil de usuario, SYSTEM no lo ve).
# PUPPETEER_EXECUTABLE_PATH="C:\Users\TU_USUARIO\.cache\puppeteer\chrome\win64-XXX\chrome-win64\chrome.exe"

PRINT_AGENT_URL=http://192.168.80.89:9120
# Timeout HTTP servidor → agente (mínimo; se escala con el tamaño del PDF).
# Lotes de 200–300 etiquetas pueden necesitar varios minutos.
PRINT_AGENT_TIMEOUT_MS=600000

# Cuántas etiquetas por trozo (cola: 30, luego el siguiente, etc.).
PRINT_LABEL_CHUNK_SIZE=30
# Pausa corta entre trozos (ms); el siguiente entra en cola al terminar el anterior.
PRINT_CHUNK_GAP_MS=400
PRINT_ADMIN_PIN=col1968
