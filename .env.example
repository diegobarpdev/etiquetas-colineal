# Desarrollo local (app en Node, Postgres en Docker)
DATABASE_URL="postgresql://colineal:colineal@localhost:5433/etiquetas?schema=public"
PORT=3000
HOST=0.0.0.0

# URL para acceder desde otra PC en la red (ej. http://192.168.1.50:3000)
# Ejecuta: npm run network:info
PUBLIC_URL=

# Docker Compose (app + postgres) usa DATABASE_URL interna en docker-compose.yml
# SEED_ON_START=true recarga datos mock al iniciar el contenedor
