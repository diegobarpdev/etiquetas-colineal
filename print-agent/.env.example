# Agente Zebra — Browser Print (PC USB con impresora)
# Copia esta carpeta a cualquier ruta. El instalador genera .env en esa PC.
# NO uses PORT 9100 ni 9101 — los reserva Zebra Browser Print.

PORT=9120
HOST=0.0.0.0

# Nombre orientativo (el instalador pone el de la Zebra detectada)
PRINTER_NAME=ZDesigner ZT230-200dpi ZPL

PRINT_DPI=203

# Servicio local Browser Print (siempre en esta misma PC)
BROWSER_PRINT_URL=http://127.0.0.1:9100

# Motor: browser-print (recomendado) | winspool | auto
SEND_ENGINE=browser-print

# URL del servidor de etiquetas (para auto-update y ACTUALIZAR-AGENTE.bat)
UPDATE_SERVER_URL=http://192.168.2.28:3000
# 1 = la PC se actualiza sola cada ~15 min / al arrancar. 0 = solo manual.
AUTO_UPDATE=1

# Lotes: Browser Print en trozos; la cola real es servidor (PDF de ~30) → agente
BP_CHUNK_PAGES=10
BP_CHUNK_MAX_BYTES=350000
BP_CHUNK_GAP_MS=250
BP_DRAIN_MS_PER_PAGE=80

# Velocidad ZPL (^PR) en ips.
PRINT_SPEED_IPS=6

# Oscuridad ZPL (^MD, -30..30). Más alto = más oscuro.
# PAPEL/tela (conforme-papel): default 22. Adhesivo: vacío = no envía ^MD.
PRINT_DARKNESS_PAPEL=22
# PRINT_DARKNESS=10

# Opcional: UID USB de Browser Print en ESTA PC (panel http://127.0.0.1:9120)
# BP_USB_ADHESIVO=
# BP_USB_PAPEL=

# Solo diagnostico (no imprime de verdad):
# PRINT_DRY_RUN=1

# Solo diagnostico (envia etiqueta por etiqueta, lento):
# PRINT_SEND_PER_LABEL=1

# NO activar en PCs con EPERM rpc.sock. Por defecto el agente usa node directo.
# USE_PM2=1
