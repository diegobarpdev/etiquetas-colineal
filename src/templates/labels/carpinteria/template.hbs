<div class="label-carpinteria">
  <div class="label">
    <h1 class="el-header">{{productName}}</h1>

    <div class="el-body">
      <section class="el-left">
        <img src="{{carpenterLogoDataUri}}" alt="Carpenter" class="el-logo" />

        <div class="el-details">
          <p class="el-short-name">{{shortName}}</p>
          <p class="el-ns">N/S: {{serialCurrent}} - {{serialTotal}}</p>
          <p class="el-bulto">BULTO: {{bultoCurrent}} - {{bultoTotal}}</p>
          <p class="el-fecha">FECHA: {{productionDate}}</p>
          <p class="el-peso">PESO: {{weightKg}} KG</p>
          <p class="el-inspector-label">INSPECTOR DE CALIDAD:</p>
          <p class="el-inspector">{{inspectorName}}</p>
        </div>
      </section>

      <section class="el-right">
        <div class="el-barcode-block">
          <img src="{{barcodeEan}}" alt="EAN" class="el-barcode" />
          <p class="el-barcode-text">{{barcodeEanDisplay}}</p>
        </div>
        <div class="el-barcode-block">
          <img src="{{barcodeRef}}" alt="Referencia" class="el-barcode" />
          <p class="el-barcode-text">{{barcodeRefDisplay}}</p>
        </div>
      </section>
    </div>

    <footer class="el-footer">HECHO EN: {{madeIn}}</footer>
  </div>
</div>
