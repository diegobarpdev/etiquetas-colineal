{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["server/*"]
    },
    "types": ["node"],
    "verbatimModuleSyntax": false,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["server/**/*", "vite.config.ts"],
  "exclude": ["dist", "node_modules", "web", "print-agent", "astro-etiquetas", "src"]
}
